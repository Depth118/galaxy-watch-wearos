/dts-v1/;

/ {
	compatible = "samsung,exynos9110";
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	#size-cells = <0x01>;
	model = "GALILEO-LARGE-BT";
	samsung,exynos-id = <0x9110 0x0b 0x00>;
	samsung,borad-id = <0x9110 0x00>;

	sysmmu@14820000 {
		compatible = "samsung,exynos-sysmmu";
		reg = <0x00 0x14820000 0x9000>;
		interrupts = <0x00 0x40 0x00 0x00 0x3f 0x00>;
		qos = <0x0f>;
		port-name = "G0, G1, VG";
		sysmmu,secure-irq;
		sysmmu,secure_base = <0x14830000>;
		sysmmu,tlb_property = <0x10a 0x00 0x1010a 0xffff0002 0x1010a 0xffff0006 0x1010a 0xffff0008>;
		#iommu-cells = <0x00>;
		phandle = <0x6a>;
	};

	sysmmu@14920000 {
		compatible = "samsung,exynos-sysmmu";
		reg = <0x00 0x14920000 0x9000>;
		interrupts = <0x00 0x3e 0x00>;
		qos = <0x0f>;
		port-name = "ABOX";
		sysmmu,no-suspend;
		sysmmu,no-rpm-control;
		sysmmu,tlb_property = <0x10a 0x00>;
		#iommu-cells = <0x00>;
		phandle = <0xab>;
	};

	sysmmu@14540000 {
		compatible = "samsung,exynos-sysmmu";
		reg = <0x00 0x14540000 0x9000>;
		interrupts = <0x00 0x113 0x00 0x00 0x114 0x00>;
		qos = <0x0f>;
		port-name = "ISP, VRA, CSIS, MCSC";
		sysmmu,secure-irq;
		sysmmu,secure_base = <0x14550000>;
		sysmmu,tlb_property = <0x10a 0x00 0x1010a 0xf0005 0x1020a 0xf0001 0x1020a 0xf0005 0x1020a 0xf0009 0x1010a 0x30003 0x1020a 0x30003 0x1020a 0xf0000 0x1020a 0xf0004 0x1020a 0xf0002 0x1020a 0xf0006 0x1020a 0xf000a>;
		#iommu-cells = <0x00>;
		phandle = <0xcb>;
	};

	sysmmu@12C50000 {
		compatible = "samsung,exynos-sysmmu";
		reg = <0x00 0x12c50000 0x9000>;
		interrupts = <0x00 0xcf 0x00 0x00 0xd0 0x00>;
		qos = <0x0f>;
		port-name = "MFC, SMFC, M2M, MCSC";
		sysmmu,secure-irq;
		sysmmu,secure_base = <0x12c60000>;
		sysmmu,tlb_property = <0x160 0x00 0x10320 0x20001 0x10140 0x3f0003 0x10100 0x3f0007 0x10100 0x3f000b 0x10240 0x3f0023 0x10200 0x3f0027 0x10200 0x3f002b 0x1010a 0xf0002 0x1010a 0xf0006 0x1010a 0xf000a 0x1020a 0xf0002 0x1020a 0xf0006 0x1020a 0xf000a>;
		#iommu-cells = <0x00>;
		phandle = <0x69>;
	};

	pd-dispaud@11864000 {
		compatible = "samsung,exynos-pd";
		reg = <0x00 0x11864000 0x20>;
		cal_id = <0xb1380000>;
		need_smc = <0x14810204>;
		status = "okay";
		power-down-ok = <0x01>;
		phandle = <0x02>;
	};

	pd-g3d@11864008 {
		compatible = "samsung,exynos-pd";
		reg = <0x00 0x11864008 0x20>;
		cal_id = <0xb1380001>;
		need_smc = <0x11410204>;
		status = "okay";
		#power-domain-cells = <0x00>;
		phandle = <0x03>;
	};

	pd-is@11864010 {
		compatible = "samsung,exynos-pd";
		reg = <0x00 0x11864010 0x20>;
		cal_id = <0xb1380002>;
		need_smc = <0x14510204>;
		skip-idle-ip;
		status = "okay";
		phandle = <0x04>;
	};

	pd-mfcmscl@11864018 {
		compatible = "samsung,exynos-pd";
		reg = <0x00 0x11864018 0x20>;
		cal_id = <0xb1380003>;
		need_smc = <0x12c20204>;
		status = "okay";
		phandle = <0x05>;
	};

	pd-vts@11864020 {
		compatible = "samsung,exynos-pd";
		reg = <0x00 0x11864020 0x20>;
		cal_id = <0xb1380004>;
		need_smc = <0x11010204>;
		skip-idle-ip;
		status = "okay";
		phandle = <0x06>;
	};

	dbgdev-pd-dispaud {
		compatible = "samsung,exynos-pd-dbg";
		samsung,power-domain = <0x02>;
	};

	dbgdev-pd-g3d {
		compatible = "samsung,exynos-pd-dbg";
		samsung,power-domain = <0x03>;
	};

	dbgdev-pd-is {
		compatible = "samsung,exynos-pd-dbg";
		samsung,power-domain = <0x04>;
	};

	dbgdev-pd-mfcmscl {
		compatible = "samsung,exynos-pd-dbg";
		samsung,power-domain = <0x05>;
	};

	dbgdev-pd-vts {
		compatible = "samsung,exynos-pd-dbg";
		samsung,power-domain = <0x06>;
	};

	tgm_drv {
		compatible = "drm,tgm_drv";
		tgm,drv_name = "tgm";
		tgm,drv_desc = "Tizen Graphics Manager";
		tgm,drv_date = "20150707";
		tgm,drv_major = <0x01>;
		tgm,drv_minor = <0x00>;
		tgm,drv_patchlevel = <0x00>;
		tgm,num_crtcs = <0x01>;
		phandle = <0xcc>;
	};

	tdm_pp {
		compatible = "tdm,tdm_pp";
		phandle = <0xcd>;
	};

	exynos_panel {
		compatible = "samsung,exynos-panel";
		lcd_info = <0x6c>;
		ddi_id = <0x407052>;
	};

	aliases {
		panel0 = "/exynos_panel";
		pinctrl0 = "/pinctrl@11850000";
		pinctrl1 = "/pinctrl@11A50000";
		pinctrl2 = "/pinctrl@11C30000";
		pinctrl3 = "/pinctrl@14A60000";
		pinctrl4 = "/pinctrl@13430000";
		pinctrl5 = "/pinctrl@139B0000";
		pinctrl6 = "/pinctrl@11180000";
		mshc0 = "/dwmmc0@13500000";
		mshc2 = "/dwmmc2@13550000";
		dpp0 = "/dpp@0x14884000";
		dpp1 = "/dpp@0x14881000";
		dpp2 = "/dpp@0x14882000";
		dsim0 = "/dsim@0x148E0000";
		decon0 = "/decon_f@0x148B0000";
		usi0 = "/usi@11C22000";
		usi1 = "/usi@11C22004";
		usi2 = "/usi@11C22010";
		usi3 = "/usi@11C22014";
		usi4 = "/usi@11C22020";
		usi5 = "/usi@11C22024";
		usi6 = "/usi@11C22030";
		usi7 = "/usi@11C22034";
		usi8 = "/usi@10021010";
		usi9 = "/usi@10021020";
		usi10 = "/usi@10021030";
		usi11 = "/usi@10021040";
		usi12 = "/usi@10021044";
		hsi2c0 = "/hsi2c@11D00000";
		hsi2c1 = "/hsi2c@11D10000";
		hsi2c2 = "/hsi2c@11D20000";
		hsi2c3 = "/hsi2c@11D30000";
		hsi2c4 = "/hsi2c@11D40000";
		hsi2c5 = "/hsi2c@11D50000";
		hsi2c6 = "/hsi2c@11D60000";
		hsi2c7 = "/hsi2c@11D70000";
		hsi2c8 = "/hsi2c@138A0000";
		hsi2c9 = "/hsi2c@13900000";
		hsi2c10 = "/hsi2c@13910000";
		spi0 = "/spi@11D00000";
		spi1 = "/spi@11D20000";
		spi2 = "/spi@11D40000";
		spi3 = "/spi@11D60000";
		spi4 = "/spi@13940000";
		spi5 = "/spi@13900000";
		uart0 = "/uart@13820000";
		ecduart = "/uart@13820000";
		uart1 = "/uart@11D00000";
		uart2 = "/uart@11D20000";
		uart3 = "/uart@11D40000";
		uart4 = "/uart@11D60000";
		uart5 = "/uart@13900000";
		scaler0 = "/scaler@12CB0000";
		mfc0 = "/mfc0@12C80000";
	};

	chipid@10000000 {
		compatible = "samsung,exynos9810-chipid";
		reg = <0x00 0x10000000 0x100>;
	};

	cpus {
		#address-cells = <0x02>;
		#size-cells = <0x00>;

		cpu@0 {
			device_type = "cpu";
			compatible = "arm,ananke\0arm,armv8";
			reg = <0x00 0x00>;
			enable-method = "psci";
			cpu-idle-states = <0x07>;
			phandle = <0x08>;
		};

		cpu@1 {
			device_type = "cpu";
			compatible = "arm,ananke\0arm,armv8";
			reg = <0x00 0x01>;
			enable-method = "psci";
			cpu-idle-states = <0x07>;
			phandle = <0x09>;
		};

		idle-states {
			entry-method = "arm,psci";

			bootcl-cpu-sleep {
				idle-state-name = "c2";
				compatible = "exynos,idle-state";
				arm,psci-suspend-param = <0x10000>;
				entry-latency-us = <0x23>;
				exit-latency-us = <0x5a>;
				min-residency-us = <0x2ee>;
				status = "okay";
				phandle = <0x07>;
			};
		};
	};

	arm-pmu {
		compatible = "arm,armv8-pmuv3";
		interrupts = <0x00 0x98 0x04 0x00 0x99 0x04>;
		interrupt-affinity = <0x08 0x09>;
	};

	psci {
		compatible = "arm,psci";
		method = "smc";
		cpu_suspend = <0xc4000001>;
		cpu_off = <0x84000002>;
		cpu_on = <0xc4000003>;
	};

	exynos-pmu {
		compatible = "samsung,exynos-pmu";
		samsung,syscon-phandle = <0x0a>;
	};

	system-controller@11860000 {
		compatible = "samsung,exynos9110-pmu\0syscon";
		reg = <0x00 0x11860000 0x10000>;
		phandle = <0x0a>;
	};

	exynos-pm {
		compatible = "samsung,exynos-pm";
		reg = <0x00 0x11850000 0x1000 0x00 0x10701200 0x100>;
		reg-names = "gpio_alive_base\0gicd_ispendrn_base";
		num-eint = <0x0d>;
		num-gic = <0x10>;
		suspend_mode_idx = <0x08>;
		suspend_psci_idx = <0x85>;
		cp_call_mode_idx = <0x0a>;
		cp_call_psci_idx = <0x85>;
		usbl2_suspend_available = <0x01>;
		usbl2_suspend_mode_idx = <0x0c>;
		extra_wakeup_stat = <0x640>;
	};

	exynos-powermode {
		eint_wakeup_mask_offset = <0x60c>;
		sicd_residency = <0xbb8>;
		sicd_enabled = <0x01>;
		sicd_block_jig = <0x01>;
		idle-ip = "13970000.pwm\tc40000.adc\td00000.hsi2c\td10000.hsi2c\td20000.hsi2c\td30000.hsi2c\td40000.hsi2c\td50000.hsi2c\td60000.hsi2c\td70000.hsi2c\v8a0000.hsi2c\v900000.hsi2c\v910000.hsi2c\td00000.spi\td20000.spi\td40000.spi\td60000.spi\v940000.spi\v900000.spi\v500000.dwmmc0\v550000.dwmmc2\v600000.usb\f8e0000.dsim\0pd-dispaud\0pd-g3d\0pd-is\0pd-mfcmscl\0pd-vts\0bluetooth";
		fix-idle-ip = "acpm_dvfs";
		fix-idle-ip-index = <0x60>;

		idle_ip_mask {

			SYS_SICD {
				mode-index = <0x00>;
				ref-idle-ip = <0x00 0x01 0x02 0x03 0x04 0x05 0x06 0x07 0x08 0x09 0x0a 0x0b 0x0c 0x0d 0x0e 0x0f 0x10 0x11 0x12 0x13 0x14 0x15 0x16 0x18 0x1a 0x1c 0x60>;
				phandle = <0xce>;
			};
		};

		wakeup-masks {

			wakeup-mask {
				mask = <0x400001e0 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x500f7e7e 0x500f7e7e 0x500f7e7e 0x00 0xd00d7e7e>;
				reg-offset = <0x610>;
			};

			wakeup-mask3 {
				mask = <0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0xffff00ff 0xffff00ff 0xffff00ff 0x00 0xffff00ff>;
				reg-offset = <0x618>;
			};
		};
	};

	interrupt-controller@10700000 {
		compatible = "arm,cortex-a15-gic\0arm,cortex-a9-gic";
		#interrupt-cells = <0x03>;
		#address-cells = <0x00>;
		interrupt-controller;
		reg = <0x00 0x10701000 0x1000 0x00 0x10702000 0x1000 0x00 0x10704000 0x2000 0x00 0x10706000 0x2000>;
		interrupts = <0x01 0x09 0xf04>;
		phandle = <0x01>;
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupts = <0x01 0x0d 0xff08 0x01 0x0e 0xff08 0x01 0x0b 0xff08 0x01 0x0a 0xff08>;
		clock-frequency = <0x18cba80>;
		use-clocksource-only;
		use-physical-timer;
	};

	clock-controller@0x11800000 {
		compatible = "samsung,exynos9110-clock";
		reg = <0x00 0x11800000 0x8000>;
		acpm-ipc-channel = <0x00>;
		#clock-cells = <0x01>;
		phandle = <0x0c>;
	};

	mct@10040000 {
		compatible = "samsung,exynos4210-mct";
		reg = <0x00 0x10040000 0x800>;
		interrupt-controller;
		#interrupt-cells = <0x01>;
		interrupt-parent = <0x0b>;
		interrupts = <0x00 0x01 0x02 0x03 0x04 0x05 0x06 0x07 0x08 0x09 0x0a 0x0b>;
		clocks = <0x0c 0x01 0x0c 0x175>;
		clock-names = "fin_pll\0mct";
		use-clockevent-only;

		mct-map {
			#interrupt-cells = <0x01>;
			#address-cells = <0x00>;
			#size-cells = <0x00>;
			interrupt-map = <0x00 0x01 0x00 0xe9 0x00 0x01 0x01 0x00 0xea 0x00 0x02 0x01 0x00 0xeb 0x00 0x03 0x01 0x00 0xec 0x00 0x04 0x01 0x00 0xed 0x00 0x05 0x01 0x00 0xee 0x00 0x06 0x01 0x00 0xef 0x00 0x07 0x01 0x00 0xf0 0x00 0x08 0x01 0x00 0xf1 0x00 0x09 0x01 0x00 0xf2 0x00 0x0a 0x01 0x00 0xf3 0x00 0x0b 0x01 0x00 0xf4 0x00>;
			phandle = <0x0b>;
		};
	};

	ITMON {
		compatible = "samsung,exynos-itmon";
		interrupts = <0x00 0x28 0x00 0x00 0x29 0x00 0x00 0x2a 0x00>;
	};

	reboot {
		compatible = "exynos,reboot";
		pmu_base = <0x11860000>;
	};

	exynos-reboot {
		compatible = "samsung,exynos-reboot";
		samsung,syscon-phandle = <0x0a>;
		shutdown-offset = <0x330c>;
		shutdown-trigger = <0x100>;
		reboot-offset = <0x400>;
		reboot-trigger = <0x01>;
		reboot-cmd-offset = <0x80c>;
	};

	amba {
		#address-cells = <0x02>;
		#size-cells = <0x01>;
		compatible = "arm,amba-bus";
		interrupt-parent = <0x01>;
		ranges;

		pdma0@10520000 {
			compatible = "arm,pl330\0arm,primecell";
			reg = <0x00 0x10520000 0x1000>;
			interrupts = <0x00 0x13 0x00>;
			clocks = <0x0c 0x15f>;
			clock-names = "apb_pclk";
			#dma-cells = <0x01>;
			#dma-channels = <0x04>;
			#dma-requests = <0x20>;
			#dma-multi-irq = <0x01>;
			dma-arwrapper = <0x10524400 0x10524420 0x10524440 0x10524460>;
			dma-awwrapper = <0x10524404 0x10524424 0x10524444 0x10524464>;
			dma-instwrapper = <0x10524480>;
			dma-mask-bit = <0x24>;
			coherent-mask-bit = <0x24>;
			phandle = <0xcf>;
		};
	};

	pinctrl@11850000 {
		compatible = "samsung,exynos9110-pinctrl";
		reg = <0x00 0x11850000 0x1000>;
		interrupts = <0x00 0x4a 0x00 0x00 0x4b 0x00 0x00 0x4c 0x00 0x00 0x4d 0x00 0x00 0x4e 0x00 0x00 0x4f 0x00 0x00 0x50 0x00 0x00 0x51 0x00 0x00 0x52 0x00 0x00 0x53 0x00 0x00 0x54 0x00 0x00 0x55 0x00 0x00 0x56 0x00 0x00 0x57 0x00>;
		phandle = <0xd0>;

		wakeup-interrupt-controller {
			compatible = "samsung,exynos7-wakeup-eint";
		};

		gpa0 {
			gpio-controller;
			#gpio-cells = <0x02>;
			interrupt-controller;
			#interrupt-cells = <0x03>;
			interrupt-parent = <0x01>;
			interrupts = <0x00 0x4a 0x00 0x00 0x4b 0x00 0x00 0x4c 0x00 0x00 0x4d 0x00 0x00 0x4e 0x00 0x00 0x4f 0x00 0x00 0x50 0x00 0x00 0x51 0x00>;
			phandle = <0x2a>;
		};

		gpa1 {
			gpio-controller;
			#gpio-cells = <0x02>;
			interrupt-controller;
			#interrupt-cells = <0x03>;
			interrupt-parent = <0x01>;
			interrupts = <0x00 0x52 0x00 0x00 0x53 0x00 0x00 0x54 0x00 0x00 0x55 0x00 0x00 0x56 0x00 0x00 0x57 0x00>;
			phandle = <0x36>;
